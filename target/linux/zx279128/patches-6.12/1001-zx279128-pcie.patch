From: Navid Ghahremani <ghahramani.navid@gmail.com>
Subject: [PATCH] PCI: dwc: add the ZTE ZX279128S PCIe host controller

Add a DesignWare based host driver for the two PCIe ports of the
ZX279128S, which connect the MT7915 Wi-Fi on the ZTE ZXHN H3600.

Signed-off-by: Navid Ghahremani <ghahramani.navid@gmail.com>
---
--- a/drivers/pci/controller/dwc/Kconfig
+++ b/drivers/pci/controller/dwc/Kconfig
@@ -518,4 +518,14 @@ config PCIE_VISCONTI_HOST
 	  Say Y here if you want PCIe controller support on Toshiba Visconti SoC.
 	  This driver supports TMPV7708 SoC.
 
+config PCIE_ZX279128
+	bool "ZTE ZX279128S PCIe controller"
+	depends on OF
+	select PCIE_DW_HOST
+	default y
+	help
+	  Say Y here to enable PCIe support for ZTE/Sanechips ZX279128S SoC.
+	  This driver supports the DesignWare-based PCIe host controller with
+	  ZTE-specific PHY and link initialization.
+
 endmenu
--- a/drivers/pci/controller/dwc/Makefile
+++ b/drivers/pci/controller/dwc/Makefile
@@ -28,6 +28,7 @@
 obj-$(CONFIG_PCIE_UNIPHIER_EP) += pcie-uniphier-ep.o
 obj-$(CONFIG_PCIE_VISCONTI_HOST) += pcie-visconti.o
 obj-$(CONFIG_PCIE_RCAR_GEN4) += pcie-rcar-gen4.o
+obj-$(CONFIG_PCIE_ZX279128) += pcie-zx279128.o
 
 # The following drivers are for devices that use the generic ACPI
 # pci_root.c driver but don't support standard ECAM config access.
--- /dev/null
+++ b/drivers/pci/controller/dwc/pcie-zx279128.c
@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ZTE ZX279128S PCIe Host Controller Driver
+ *
+ * Copyright (C) 2026 OpenWrt.org
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+#include <linux/resource.h>
+
+#include "pcie-designware.h"
+
+struct zx_pcie {
+	struct dw_pcie		pci;
+	void __iomem		*topcrm1;	/* 0x94000000: Top CRM 1 (PLL / PHY ctrl) */
+	void __iomem		*topcrm2;	/* 0x94100000: Top CRM 2 (clocks & resets) */
+	void __iomem		*topcrm3;	/* 0x94200000: Top CRM 3 (GPIO CRM) */
+	void __iomem		*ctrl_base;	/* 0x09500000 (P0) or 0x09600000 (P1) */
+	struct gpio_desc	*reset_gpio;
+	struct gpio_desc	*enable_gpio;
+	int			port_id;
+};
+
+#define to_zx_pcie(x)	dev_get_drvdata((x)->dev)
+
+static void zx279128_pcie_init_hw(struct zx_pcie *pcie)
+{
+	struct dw_pcie *pci = &pcie->pci;
+	struct device *dev = pci->dev;
+
+	/* The MT7915 is powered, reset-released and firmware-booted by U-Boot
+	 * before Linux starts (its MTK WLAN driver loads the firmware:
+	 * "eeFlashId=7915"), and neither U-Boot nor the stock Linux driver
+	 * ever toggles the board enable/reset lines afterwards. Pulsing the
+	 * enable line (pad 55) restarts the MT7915 boot flow: the PHY still
+	 * trains to L0 (LTSSM 0x11) but the chip's PCIe function answers no
+	 * config request until its firmware is back, and the resulting
+	 * completion timeout escalates into a CPU external abort (DFS 0x2d)
+	 * on the very first bus-0 config read. Leave the chip exactly as
+	 * U-Boot left it; only make sure the enable line is HIGH.
+	 */
+	if (pcie->enable_gpio)
+		gpiod_set_raw_value_cansleep(pcie->enable_gpio, 1);
+	if (pcie->reset_gpio)
+		gpiod_set_raw_value_cansleep(pcie->reset_gpio, 1);
+
+	dev_info(dev, "pcie%d: configuring CRM registers\n", pcie->port_id);
+
+	/* Top CRM 2 (0x94100000): PCIe global clock enable. Stock driver
+	 * writes 0xff here once in probe before any per-port setting;
+	 * without it the PHY clocks stay gated and LTSSM never leaves
+	 * Detect.Quiet (verified against live stock: 0x9410009c == 0xff).
+	 */
+	writel(0xff, pcie->topcrm2 + 0x9c);
+	udelay(50);
+	dev_info(dev, "pcie%d: 0x9c clock-enable done\n", pcie->port_id);
+
+	if (pcie->port_id == 0) {
+		/* Port 0 setting sequence from ZTE firmware */
+		/* 1. Top CRM 2 (0x94100000): ungate PCIe 0 clock */
+		writel(readl(pcie->topcrm2 + 0x70) | 0xb5, pcie->topcrm2 + 0x70);
+		udelay(50);
+
+		/* 2. Top CRM 1 (0x94000000): PCIe 0 PHY/PLL configuration */
+		writel(readl(pcie->topcrm1 + 0x08) | 0x8000, pcie->topcrm1 + 0x08);
+		udelay(50);
+		writel(readl(pcie->topcrm1 + 0x08) | 0x2000, pcie->topcrm1 + 0x08);
+		udelay(50);
+		writel(readl(pcie->topcrm1 + 0x08) | 0x4000, pcie->topcrm1 + 0x08);
+		udelay(50);
+
+		/* 3. Top CRM 2 (0x94100000): release PCIe 0 reset bit 0 */
+		writel(readl(pcie->topcrm2 + 0x74) & ~1, pcie->topcrm2 + 0x74);
+		udelay(50);
+
+		/* 4. Top CRM 3 (0x94200000): GPIO CRM */
+		if (pcie->topcrm3)
+			writel(readl(pcie->topcrm3 + 0x0c) & ~0x4000, pcie->topcrm3 + 0x0c);
+		udelay(500);
+
+		/* 5. Top CRM 1 (0x94000000): bit 26 clear */
+		writel(readl(pcie->topcrm1 + 0x24) & ~0x4000000, pcie->topcrm1 + 0x24);
+		udelay(50);
+
+		/* 6. Top CRM 2 (0x94100000): deassert resets */
+		writel(readl(pcie->topcrm2 + 0x74) | 1, pcie->topcrm2 + 0x74);
+		writel(readl(pcie->topcrm2 + 0x70) & ~0x100, pcie->topcrm2 + 0x70);
+		writel(0x3f, pcie->topcrm2 + 0x74);
+
+		/* 7. Controller wrapper (0x09500000): enable bit 0x20 */
+		writel(readl(pcie->ctrl_base + 0x00) | 0x20, pcie->ctrl_base + 0x00);
+	} else {
+		/* Port 1 setting sequence from ZTE firmware */
+		/* 1. Top CRM 2 (0x94100000): ungate PCIe 1 clock */
+		writel(readl(pcie->topcrm2 + 0x70) | 0x1aa00, pcie->topcrm2 + 0x70);
+		udelay(50);
+
+		/* 2. Top CRM 1 (0x94000000): PCIe 1 PHY/PLL configuration & calibration */
+		writel(readl(pcie->topcrm1 + 0x08) | 0x8000000, pcie->topcrm1 + 0x08);
+		udelay(50);
+		writel(0x00202d5a, pcie->topcrm1 + 0x1b4);
+		writel(0x0046c24a, pcie->topcrm1 + 0x1b0);
+		writel(readl(pcie->topcrm1 + 0x08) | 0x2000000, pcie->topcrm1 + 0x08);
+		udelay(50);
+		writel(readl(pcie->topcrm1 + 0x08) | 0x4000000, pcie->topcrm1 + 0x08);
+		udelay(50);
+
+		/* 3. Top CRM 2 (0x94100000): release PCIe 1 reset bit 3 */
+		writel(readl(pcie->topcrm2 + 0x74) & ~8, pcie->topcrm2 + 0x74);
+		udelay(50);
+
+		/* 4. Top CRM 3 (0x94200000): GPIO CRM */
+		if (pcie->topcrm3)
+			writel(readl(pcie->topcrm3 + 0x0c) & ~0x0002, pcie->topcrm3 + 0x0c);
+		udelay(50);
+
+		/* 5. Top CRM 1 (0x94000000): bit 26 clear */
+		writel(readl(pcie->topcrm1 + 0x24) & ~0x4000000, pcie->topcrm1 + 0x24);
+		udelay(50);
+
+		/* 6. Top CRM 2 (0x94100000): deassert resets */
+		writel(readl(pcie->topcrm2 + 0x74) | 8, pcie->topcrm2 + 0x74);
+		writel(readl(pcie->topcrm2 + 0x70) & ~0x20000, pcie->topcrm2 + 0x70);
+		writel(0x3f, pcie->topcrm2 + 0x74);
+
+		/* 7. Controller wrapper (0x09600000): enable bit 0x20 */
+		writel(readl(pcie->ctrl_base + 0x00) | 0x20, pcie->ctrl_base + 0x00);
+	}
+
+	/* 8. Link capabilities: set max link width = 1 & retrain */
+	writel((readl(pcie->pci.dbi_base + 0xa0) & ~0xf) | 1, pcie->pci.dbi_base + 0xa0);
+	writel(readl(pcie->pci.dbi_base + 0x80) | 0x20, pcie->pci.dbi_base + 0x80);
+
+	dev_info(dev, "pcie%d: CRM initialized successfully\n", pcie->port_id);
+}
+
+static int zx_pcie_start_link(struct dw_pcie *pci)
+{
+	struct zx_pcie *pcie = to_zx_pcie(pci);
+	u32 val;
+	int retries = 2000;
+
+	/* Configure target link width = 1 and trigger link retrain */
+	dw_pcie_dbi_ro_wr_en(pci);
+	writel((readl(pci->dbi_base + 0xa0) & ~0xf) | 1, pci->dbi_base + 0xa0);
+	writel(readl(pci->dbi_base + 0x80) | 0x20, pci->dbi_base + 0x80);
+	dw_pcie_dbi_ro_wr_dis(pci);
+
+	while (retries--) {
+		val = readl(pcie->ctrl_base + 0xdc);
+		if (((val >> 17) & 0x3f) == 0x11) {
+			u32 link_stat = readl(pci->dbi_base + 0x80);
+			u32 speed = (link_stat >> 16) & 0xf;
+			struct dw_pcie_rp *pp = &pcie->pci.pp;
+			struct dw_pcie_ob_atu_cfg atu = { 0 };
+
+			dev_info(pci->dev, "pcie%d link up, gen%u (LTSSM L0, stat 0x%08x)\n",
+				 pcie->port_id, speed ? 2 : 1, val);
+
+			/* Diagnostic: read the endpoint VID/DID through the
+			 * CFG0 window before the PCI core touches it. Safe
+			 * here: iATU geometry is known (setup_rc ran) and the
+			 * link is up. If the chip were silent this read
+			 * would escalate into a CPU external abort on this
+			 * SoC, so the value printed here is the last thing
+			 * seen in that case; when it answers we expect
+			 * 0x791514c3 (port 0) / 0x791614c3 (port 1).
+			 */
+			atu.type = PCIE_ATU_TYPE_CFG0;
+			atu.cpu_addr = pp->cfg0_base;
+			atu.pci_addr = PCIE_ATU_BUS(0) | PCIE_ATU_DEV(0) |
+				       PCIE_ATU_FUNC(0);
+			atu.size = pp->cfg0_size;
+			if (!dw_pcie_prog_outbound_atu(pci, &atu))
+				dev_info(pci->dev, "pcie%d: CFG0 bus0/dev0 VID:DID = 0x%08x\n",
+					 pcie->port_id, readl(pp->va_cfg0_base));
+			return 0;
+		}
+		udelay(100);
+	}
+
+	val = readl(pcie->ctrl_base + 0xdc);
+	dev_warn(pci->dev, "pcie%d link timeout (LTSSM: 0x%02x, ctrl 0xdc: 0x%08x)\n",
+		 pcie->port_id, (val >> 17) & 0x3f, val);
+	return 0;
+}
+
+static int zx_pcie_link_up(struct dw_pcie *pci)
+{
+	struct zx_pcie *pcie = to_zx_pcie(pci);
+	u32 val = readl(pcie->ctrl_base + 0xdc);
+
+	return ((val >> 17) & 0x3f) == 0x11;
+}
+
+static const struct dw_pcie_ops zx_dw_pcie_ops = {
+	.link_up	= zx_pcie_link_up,
+	.start_link	= zx_pcie_start_link,
+};
+
+/*
+ * The MT7915 is wired directly to each DWC root port with no intervening
+ * PCI-to-PCI bridge: the stock ZTE driver enumerates it as a plain type-0
+ * endpoint sitting on the root bus itself (pci 0000:00:00.0 on port 0,
+ * pci 0000:01:00.0 on port 1), never as a device behind a bridge.
+ *
+ * The generic DWC host code instead exposes the controller's own DBI header
+ * at bus 0 / dev 0. That header is a type-1 bridge, so the PCI core assigns
+ * it a secondary bus and scans the child bus with a CFG1 (type-1) config
+ * request. The MT7915 does not sit behind that bridge and never completes a
+ * type-1 request; on this SoC the missing completion escalates straight into
+ * a CPU external abort (Oops in pci_generic_config_read), halting the box.
+ *
+ * Override the root-bus config ops so every access is emitted as a CFG0
+ * (type-0) request aimed at bus 0 / dev 0, reaching the endpoint directly
+ * exactly like the stock driver. Only dev 0 / func 0 exists, so any other
+ * device/function returns "no device" without ever putting a TLP on the
+ * link - a stray request to an absent function would hang the same way.
+ */
+static void __iomem *zx_pcie_conf_map_bus(struct pci_bus *bus,
+					  unsigned int devfn, int where)
+{
+	struct dw_pcie_rp *pp = bus->sysdata;
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct dw_pcie_ob_atu_cfg atu = { 0 };
+
+	if (devfn != 0)
+		return NULL;
+
+	if (!dw_pcie_link_up(pci))
+		return NULL;
+
+	atu.type = PCIE_ATU_TYPE_CFG0;
+	atu.cpu_addr = pp->cfg0_base;
+	atu.pci_addr = PCIE_ATU_BUS(0) | PCIE_ATU_DEV(0) | PCIE_ATU_FUNC(0);
+	atu.size = pp->cfg0_size;
+
+	if (dw_pcie_prog_outbound_atu(pci, &atu))
+		return NULL;
+
+	return pp->va_cfg0_base + where;
+}
+
+static struct pci_ops zx_pcie_ops = {
+	.map_bus = zx_pcie_conf_map_bus,
+	.read = pci_generic_config_read,
+	.write = pci_generic_config_write,
+};
+
+static int zx_pcie_host_init(struct dw_pcie_rp *pp)
+{
+	/*
+	 * Reach the MT7915 as a type-0 endpoint on the root bus (see
+	 * zx_pcie_conf_map_bus). Keep child_ops as the DWC default so
+	 * dw_pcie_setup_rc() still programs the MEM outbound windows; the
+	 * endpoint is not a bridge, so no child bus is ever scanned.
+	 *
+	 * Do NOT program the CFG0 iATU window from here: dw_pcie_host_init()
+	 * calls ops->init before dw_pcie_iatu_setup() has discovered the
+	 * iATU geometry, so pci->region_align is still 0 and
+	 * dw_pcie_prog_outbound_atu() would reject the window (-EINVAL).
+	 * The window is programmed per-access in zx_pcie_conf_map_bus().
+	 */
+	pp->bridge->ops = &zx_pcie_ops;
+
+	return 0;
+}
+
+static int zx_pcie_msi_init(struct dw_pcie_rp *pp)
+{
+	/* ZTE ZX279128 uses legacy INTx via GIC SPI interrupts */
+	return 0;
+}
+
+static const struct dw_pcie_host_ops zx_pcie_host_ops = {
+	.init = zx_pcie_host_init,
+	.msi_init = zx_pcie_msi_init,
+};
+
+static int zx_pcie_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct zx_pcie *pcie;
+	struct dw_pcie *pci;
+	struct resource *res;
+	int ret;
+
+	pcie = devm_kzalloc(dev, sizeof(*pcie), GFP_KERNEL);
+	if (!pcie)
+		return -ENOMEM;
+
+	pci = &pcie->pci;
+	pci->dev = dev;
+	pci->ops = &zx_dw_pcie_ops;
+	pci->pp.ops = &zx_pcie_host_ops;
+
+	/* Determine port ID (0 or 1) */
+	if (of_property_read_u32(dev->of_node, "port-id", &pcie->port_id))
+		pcie->port_id = 0;
+
+	dev_info(dev, "Probing ZTE ZX279128S PCIe port %d...\n", pcie->port_id);
+
+	/* Map DBI registers */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dbi");
+	if (!res) {
+		dev_err(dev, "Missing dbi resource\n");
+		return -EINVAL;
+	}
+	pci->dbi_base = devm_pci_remap_cfg_resource(dev, res);
+	if (IS_ERR(pci->dbi_base))
+		return PTR_ERR(pci->dbi_base);
+	pci->dbi_phys_addr = res->start;
+
+	/* Map Controller registers */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ctrl");
+	if (!res) {
+		dev_err(dev, "Missing ctrl resource\n");
+		return -EINVAL;
+	}
+	pcie->ctrl_base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(pcie->ctrl_base))
+		return PTR_ERR(pcie->ctrl_base);
+
+	/* Map Top CRM 1 (0x94000000: PLL & PHY ctrl) */
+	pcie->topcrm1 = devm_ioremap(dev, 0x94000000, 0x1000);
+	if (!pcie->topcrm1) {
+		dev_err(dev, "Failed to map Top CRM 1\n");
+		return -ENOMEM;
+	}
+
+	/* Map Top CRM 2 (0x94100000: Clocks & Resets) */
+	pcie->topcrm2 = devm_ioremap(dev, 0x94100000, 0x1000);
+	if (!pcie->topcrm2) {
+		dev_err(dev, "Failed to map Top CRM 2\n");
+		return -ENOMEM;
+	}
+
+	/* Map Top CRM 3 (0x94200000: GPIO CRM) */
+	pcie->topcrm3 = devm_ioremap(dev, 0x94200000, 0x1000);
+
+	/* Reset and enable GPIOs */
+	pcie->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(pcie->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(pcie->reset_gpio), "Failed to get reset GPIO\n");
+
+	pcie->enable_gpio = devm_gpiod_get_optional(dev, "enable", GPIOD_ASIS);
+	if (IS_ERR(pcie->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(pcie->enable_gpio), "Failed to get enable GPIO\n");
+
+	platform_set_drvdata(pdev, pcie);
+
+	/* Initialize hardware clocks, resets, and wrapper BEFORE DWC host init */
+	zx279128_pcie_init_hw(pcie);
+
+	ret = dw_pcie_host_init(&pci->pp);
+	if (ret) {
+		dev_err(dev, "dw_pcie_host_init failed: %d\n", ret);
+		return ret;
+	}
+
+	dev_info(dev, "ZTE ZX279128S PCIe port %d probed successfully\n", pcie->port_id);
+	return 0;
+}
+
+static const struct of_device_id zx_pcie_of_match[] = {
+	{ .compatible = "zte,zx279128s-pcie" },
+	{ .compatible = "zte,ZX279127-pcie" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, zx_pcie_of_match);
+
+static struct platform_driver zx_pcie_driver = {
+	.driver = {
+		.name	= "zx279128-pcie",
+		.of_match_table = zx_pcie_of_match,
+		.suppress_bind_attrs = true,
+	},
+	.probe = zx_pcie_probe,
+};
+builtin_platform_driver(zx_pcie_driver);
+
+MODULE_DESCRIPTION("ZTE ZX279128S PCIe Host Controller Driver");
+MODULE_LICENSE("GPL");
