From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikko Rantakoski <mikko.rantakoski@gmail.com>
Date: Mon, 06 Oct 2026 12:00:00 +0300
Subject: [PATCH] zx279128: hook SPIFC driver into MTD build

Add the spifc/ driver directory and its Kconfig entry to drivers/mtd.

diff --git a/drivers/mtd/Makefile b/drivers/mtd/Makefile
--- a/drivers/mtd/Makefile	2026-09-27 23:14:22.678328605 +0300
+++ b/drivers/mtd/Makefile	2026-09-27 23:14:47.558657399 +0300
@@ -11,6 +11,8 @@
 
 obj-$(CONFIG_MTD_SPLIT)		+= mtdsplit/
 
+obj-$(CONFIG_MTD_NAND_ZTE_SPIFC)       += spifc/
+
 # 'Users' - code which presents functionality to userspace.
 obj-$(CONFIG_MTD_BLKDEVS)	+= mtd_blkdevs.o
 obj-$(CONFIG_MTD_BLOCK)		+= mtdblock.o

diff --git a/drivers/mtd/Kconfig b/drivers/mtd/Kconfig
--- a/drivers/mtd/Kconfig	2026-09-27 23:14:22.682328658 +0300
+++ b/drivers/mtd/Kconfig	2026-09-27 23:14:22.694328813 +0300
@@ -29,6 +29,8 @@
 
 source "drivers/mtd/mtdsplit/Kconfig"
 
+source "drivers/mtd/spifc/Kconfig"
+
 endmenu
 
 config MTD_TESTS
