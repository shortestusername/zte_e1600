From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikko Rantakoski <mikko.rantakoski@gmail.com>
Date: Mon, 06 Oct 2026 12:00:00 +0300
Subject: [PATCH] zx279128: add UART and earlycon driver build rules

Build the zx279128 UART serial driver with SERIAL_CORE and the earlycon with SERIAL_EARLYCON.

diff --git a/drivers/tty/serial/Makefile b/drivers/tty/serial/Makefile
--- a/drivers/tty/serial/Makefile
+++ b/drivers/tty/serial/Makefile
@@ -6,6 +6,8 @@
 obj-$(CONFIG_SERIAL_CORE) += serial_base.o
 serial_base-y := serial_core.o serial_base_bus.o serial_ctrl.o serial_port.o
+obj-$(CONFIG_SERIAL_CORE) += zx279128-uart.o
 
 obj-$(CONFIG_SERIAL_EARLYCON) += earlycon.o
+obj-$(CONFIG_SERIAL_EARLYCON) += zx279128-earlycon.o
 obj-$(CONFIG_SERIAL_EARLYCON_SEMIHOST) += earlycon-semihost.o
 obj-$(CONFIG_SERIAL_EARLYCON_RISCV_SBI) += earlycon-riscv-sbi.o
